@model List<JobBoardPlatform.Models.Application>

@{
    ViewBag.Title = "Pending Job Applications";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
</head>
<body class="bg-gray-50">
    <div class="min-h-screen">
        <!-- Header Section -->
        <div class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center py-6">
                    <div class="flex items-center space-x-4">
                        <div class="flex-shrink-0 bg-yellow-50 rounded-xl p-3">
                            <i data-feather="clock" class="h-6 w-6 text-yellow-600"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900">@ViewBag.Title</h1>
                            <p class="text-sm text-gray-500 mt-1">Review and manage pending job applications</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Overview -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8" data-aos="fade-up">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-500">Total Pending</p>
                            <p class="text-2xl font-bold text-gray-900 mt-1">@Model.Count</p>
                        </div>
                        <div class="bg-yellow-50 rounded-lg p-3">
                            <i data-feather="clock" class="h-5 w-5 text-yellow-600"></i>
                        </div>
                    </div>
                </div>
                @*<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-500">This Week</p>
                            <p class="text-2xl font-bold text-gray-900 mt-1">0</p>
                        </div>
                        <div class="bg-blue-50 rounded-lg p-3">
                            <i data-feather="calendar" class="h-5 w-5 text-blue-600"></i>
                        </div>
                    </div>
                </div>*@
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-500">Require Action</p>
                            <p class="text-2xl font-bold text-gray-900 mt-1">@Model.Count</p>
                        </div>
                        <div class="bg-red-50 rounded-lg p-3">
                            <i data-feather="alert-circle" class="h-5 w-5 text-red-600"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table Section -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden" data-aos="fade-up" data-aos-delay="100">
                <!-- Table Header -->
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold text-gray-800">Pending Applications</h3>
                        <div class="text-sm text-gray-500">
                            <span class="font-semibold text-gray-700">@Model.Count</span> applications awaiting review
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Candidate
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Job Details
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Employer
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Applied Date
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Status
                                </th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Resume
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var app in Model)
                            {
                                <tr class="hover:bg-gray-50 transition-all duration-150 ease-in-out group">
                                    <!-- Candidate -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-gradient-to-br from-blue-100 to-blue-50 flex items-center justify-center shadow-sm group-hover:shadow transition-shadow duration-200">
                                                <i data-feather="user" class="h-5 w-5 text-blue-600"></i>
                                            </div>
                                            <div class="ml-4">
                                                <div class="text-sm font-semibold text-gray-900">@app.CandidateName</div>
                                                <div class="text-xs text-gray-500 mt-0.5">ID: @app.Id</div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Job Title -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gray-900">@app.JobTitle</div>
                                        <div class="text-xs text-gray-500 mt-0.5 flex items-center">
                                            <i data-feather="briefcase" class="h-3 w-3 mr-1"></i>
                                            Position
                                        </div>
                                    </td>

                                    <!-- Employer -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gray-900">@app.EmployerName</div>
                                        <div class="text-xs text-gray-500 mt-0.5 flex items-center">
                                            <i data-feather="building" class="h-3 w-3 mr-1"></i>
                                            Company
                                        </div>
                                    </td>

                                    <!-- Applied Date -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gray-900">@app.AppliedDate.ToString("dd-MM-yyyy")</div>
                                        <div class="text-xs text-gray-500 mt-0.5 flex items-center">
                                            <i data-feather="calendar" class="h-3 w-3 mr-1"></i>
                                            Applied
                                        </div>
                                    </td>

                                    <!-- Status -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200">
                                            <i data-feather="clock" class="h-3 w-3 mr-1.5"></i>
                                            @app.Status
                                        </div>
                                    </td>

                                    <!-- Resume -->
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        @if (!string.IsNullOrEmpty(app.ResumePath))
                                        {
                                            <a href="@Url.Content(app.ResumePath)"
                                               class="inline-flex items-center px-3 py-2 rounded-lg text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-all duration-200 hover:shadow-sm"
                                               download>
                                                <i data-feather="download" class="h-3 w-3 mr-1.5"></i>
                                                Download
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 italic">No Resume</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Table Footer -->
                <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
                    <div class="text-sm text-gray-500">
                        <span class="font-semibold text-gray-700">@Model.Count</span> pending applications total
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        AOS.init({
            duration: 600,
            once: true
        });
        feather.replace();
    </script>
</body>
</html>