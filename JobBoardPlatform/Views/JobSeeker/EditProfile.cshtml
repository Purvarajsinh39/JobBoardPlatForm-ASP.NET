@model JobBoardPlatform.Models.User
@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (ViewBag.Msg != null)
{
    <div class="alert alert-info p-4 mb-4 bg-blue-100 border border-blue-400 text-blue-700 rounded">
        @ViewBag.Msg
    </div>
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Styles and Scripts -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>

    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .profile-avatar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: 4px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 25px -5px rgba(102, 126, 234, 0.4);
        }

        .form-input {
            transition: all 0.3s ease;
            border: 2px solid #e2e8f0;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        }

            .form-input:focus {
                border-color: #667eea;
                background: white;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                transform: translateY(-2px);
            }

        .submit-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .submit-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                transition: left 0.5s;
            }

            .submit-btn:hover::before {
                left: 100%;
            }

            .submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px -5px rgba(102, 126, 234, 0.4);
            }

        .success-message {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            animation: slideIn 0.5s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .floating {
            animation: floating 3s ease-in-out infinite;
        }

        @@keyframes floating {
            0%, 100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .pulse-ring {
            animation: pulseRing 2s infinite;
        }

        @@keyframes pulseRing {
            0% {
                box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.7);
            }

            70% {
                box-shadow: 0 0 0 20px rgba(102, 126, 234, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(102, 126, 234, 0);
            }
        }

        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 10;
        }

        .input-with-icon {
            padding-left: 3rem;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #64748b;
            z-index: 10;
        }

            .password-toggle:hover {
                color: #334155;
            }

        .text-white {
            color: #ffffff;
        }

        .text-blue-50 {
            color: rgba(239, 246, 255, 0.9);
        }

        .quick-action-item {
            transition: all 0.3s ease;
            border-radius: 10px;
        }

            .quick-action-item:hover {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                transform: translateX(5px);
            }

                .quick-action-item:hover i {
                    color: white;
                }
    </style>
</head>
<body class="gradient-bg">
    <div class="min-h-screen py-8">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header Section -->
            <div class="text-center mb-12" data-aos="fade-up">
                <div class="relative inline-block">
                    <div class="profile-avatar w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6 floating">
                        <i data-feather="user" class="w-12 h-12 text-white"></i>
                    </div>
                    <div class="pulse-ring absolute inset-0 rounded-full"></div>
                </div>
                <h1 class="text-4xl font-bold text-white mb-4" style="color:slateblue;">My Profile</h1>
                <p class="text-xl text-blue-50 max-w-2xl mx-auto" style="color:slateblue;">
                    Manage your personal information and account settings
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left Column - Quick Actions -->
                <div class="lg:col-span-1" data-aos="fade-right">
                    <div class="glass-card rounded-2xl p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                            <i data-feather="zap" class="w-5 h-5 mr-2 text-blue-600"></i>
                            Quick Actions
                        </h3>

                        <div class="space-y-3">
                            <a href="@Url.Action("MyApplications", "JobSeeker")"
                               class="quick-action-item flex items-center p-4 text-gray-700 hover:text-white rounded-lg transition-all duration-300">
                                <i data-feather="briefcase" class="w-5 h-5 mr-3 text-blue-600"></i>
                                <div>
                                    <div class="font-medium text-sm">View Applications</div>
                                    <div class="text-xs text-white-500 mt-1">Check your job applications</div>
                                </div>
                            </a>

                            <a href="@Url.Action("Dashboard", "JobSeeker")"
                               class="quick-action-item flex items-center p-4 text-gray-700 hover:text-white rounded-lg transition-all duration-300">
                                <i data-feather="search" class="w-5 h-5 mr-3 text-green-600"></i>
                                <div>
                                    <div class="font-medium text-sm">Browse Jobs</div>
                                    <div class="text-xs text-white-500 mt-1">Find new opportunities</div>
                                </div>
                            </a>

                            <a href="@Url.Action("EditProfile", "JobSeeker")"
                               class="quick-action-item flex items-center p-4 text-gray-700 hover:text-white rounded-lg transition-all duration-300">
                                <i data-feather="user" class="w-5 h-5 mr-3 text-purple-600"></i>
                                <div>
                                    <div class="font-medium text-sm">Profile Settings</div>
                                    <div class="text-xs text-white-500 mt-1">Update your information</div>
                                </div>
                            </a>

                            <a href="@Url.Action("Logout", "Account")"
                               class="quick-action-item flex items-center p-4 text-gray-700 hover:text-white rounded-lg transition-all duration-300">
                                <i data-feather="log-out" class="w-5 h-5 mr-3 text-red-600"></i>
                                <div>
                                    <div class="font-medium text-sm">Logout</div>
                                    <div class="text-xs text-white-500 mt-1">Sign out of your account</div>
                                </div>
                            </a>
                        </div>

                        <!-- Additional Info -->
                        <div class="mt-8 p-4 bg-blue-50 rounded-xl border border-blue-200">
                            <div class="flex items-start space-x-3">
                                <i data-feather="shield" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"></i>
                                <div>
                                    <p class="text-sm font-medium text-blue-800">Your data is secure</p>
                                    <p class="text-xs text-blue-600 mt-1">
                                        We use encryption to protect your personal information
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Form -->
                <div class="lg:col-span-2" data-aos="fade-left">
                    <div class="glass-card rounded-2xl overflow-hidden">
                        <div class="px-8 py-6 border-b border-gray-200">
                            <h2 class="text-2xl font-bold gradient-text flex items-center">
                                <i data-feather="edit-3" class="w-6 h-6 mr-3"></i>
                                Edit Profile Information
                            </h2>
                        </div>

                        <div class="p-8">
                            <!-- Success Message -->
                            @if (TempData["Msg"] != null)
                            {
                                <div class="success-message mb-8 p-4 rounded-xl text-white shadow-lg">
                                    <div class="flex items-center">
                                        <i data-feather="check-circle" class="w-6 h-6 mr-3"></i>
                                        <div>
                                            <p class="font-semibold">Success!</p>
                                            <p class="text-blue-100 mt-1">@TempData["Msg"]</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Form -->
                            @using (Html.BeginForm("EditProfile", "JobSeeker", FormMethod.Post))
                            {
                                <div class="space-y-6">
                                    <!-- Name Field -->
                                    <div class="input-group">
                                        <i data-feather="user" class="input-icon w-5 h-5"></i>
                                        @Html.TextBoxFor(m => m.Name, new
                                        {
                                            @class = "form-input input-with-icon w-full rounded-xl p-4 focus:outline-none",
                                            required = "required",
                                            placeholder = "Enter your full name"
                                        })
                                    </div>

                                    <!-- Email Field -->
                                    <div class="input-group">
                                        <i data-feather="mail" class="input-icon w-5 h-5"></i>
                                        @Html.TextBoxFor(m => m.Email, new
                                        {
                                            @class = "form-input input-with-icon w-full rounded-xl p-4 focus:outline-none",
                                            required = "required",
                                            type = "email",
                                            placeholder = "Enter your email address"
                                        })
                                    </div>

                                    <!-- Password Field -->
                                    <div class="input-group">
                                        <i data-feather="lock" class="input-icon w-5 h-5"></i>
                                        @Html.PasswordFor(m => m.Password, new
                                        {
                                            @class = "form-input input-with-icon w-full rounded-xl p-4 focus:outline-none pr-12",
                                            required = "required",
                                            placeholder = "Enter your password",
                                            id = "passwordField"
                                        })
                                        <i data-feather="eye" class="password-toggle w-5 h-5" id="passwordToggle"></i>
                                    </div>

                                    <!-- Form Tips -->
                                    <div class="bg-blue-50 rounded-xl p-4 border border-blue-200">
                                        <div class="flex items-start space-x-3">
                                            <i data-feather="info" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"></i>
                                            <div>
                                                <p class="text-sm font-medium text-blue-800">Profile Tips</p>
                                                <p class="text-sm text-blue-600 mt-1">
                                                    Keep your information up to date to improve your job application success rate.
                                                    Ensure your email is correct to receive important notifications.
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Submit Button -->
                                    <div class="pt-4">
                                        <button type="submit"
                                                class="submit-btn w-full flex items-center justify-center space-x-3 py-4 px-6 text-white rounded-xl font-semibold text-lg transition-all duration-300">
                                            <i data-feather="save" class="w-5 h-5"></i>
                                            <span>Update Profile</span>
                                            <i data-feather="arrow-right" class="w-5 h-5"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script>
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });
        feather.replace();

        // Password toggle functionality
        const passwordField = document.getElementById('passwordField');
        const passwordToggle = document.getElementById('passwordToggle');

        passwordToggle.addEventListener('click', function () {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);

            // Toggle eye icon
            const icon = this;
            if (type === 'text') {
                icon.setAttribute('data-feather', 'eye-off');
            } else {
                icon.setAttribute('data-feather', 'eye');
            }
            feather.replace();
        });

        // Add focus effects to form inputs
        document.querySelectorAll('.form-input').forEach(input => {
            input.addEventListener('focus', function () {
                this.parentElement.classList.add('focused');
            });

            input.addEventListener('blur', function () {
                this.parentElement.classList.remove('focused');
            });
        });

        // Auto-hide success message after 5 seconds
        const successMessage = document.querySelector('.success-message');
        if (successMessage) {
            setTimeout(() => {
                successMessage.style.opacity = '0';
                successMessage.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    successMessage.remove();
                }, 500);
            }, 5000);
        }

        // Quick actions hover effects
        document.querySelectorAll('.quick-action-item').forEach(item => {
            item.addEventListener('mouseenter', function () {
                const icon = this.querySelector('i');
                const originalColor = icon.style.color;
                icon.style.transition = 'color 0.3s ease';
            });
        });
    </script>
</body>
</html>